# The teaching environment may provide PORTKEY_API_KEY in a .env file one
# directory above this repository. A local .env in this repository takes
# precedence when present. The backend currently needs only PORTKEY_API_KEY.
# Backend port is documented for convenience; uvicorn's --port option controls it.
PORT=8000
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_API_ENDPOINT=https://api.portkey.ai/v1/chat/completions
MORETHANMEETSAI_INTERPRETATION_ENABLED=true
MORETHANMEETSAI_INTERPRETATION_MODEL=gpt-4o-mini
